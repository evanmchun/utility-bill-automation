CLEVELANDWATER_USERNAME=your_username
CLEVELANDWATER_PASSWORD=your_password

# Optional:
# OUTPUT_DIR=.
# HEADLESS=true

# Email alerts (Gmail App Password required):
# WATER_ALERTS_ENABLED=false
# ALERT_EMAIL_FROM=your-email@gmail.com
# ALERT_EMAIL_TO=recipient@example.com
# GMAIL_APP_PASSWORD=your-16-digit-app-password

# Daily usage must be greater than this limit to send an alert:
# WATER_ALERT_DAILY_LIMIT_GALLONS=200
# Hourly usage at or above this limit sends an alert:
# WATER_ALERT_HOURLY_LIMIT_GALLONS=150
# Send another alert at each additional usage level:
# WATER_ALERT_INCREMENT_GALLONS=100
# WATER_ALERT_BASELINE_DAYS=14
